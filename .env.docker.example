# Docker Compose Environment Variables
# Copy this to .env in the root directory for Docker Compose

# ============ Database ============
# CRITICAL: Change these in production!
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE-THIS-SECURE-PASSWORD-MIN-16-CHARS
POSTGRES_DB=docassist
POSTGRES_PORT=5432

# ============ Application ============
DEBUG=false
ENVIRONMENT=production  # Options: development, staging, production

# ============ Security ============
# CRITICAL: Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE-THIS-GENERATE-WITH-OPENSSL-RAND-HEX-32

# ============ CORS Origins ============
# Add your production domains (JSON array format)
CORS_ORIGINS=["https://yourdomain.com", "https://app.yourdomain.com"]

# ============ Rate Limiting ============
RATE_LIMIT_PER_MINUTE=60

# ============ Ports ============
BACKEND_PORT=8000

# ============ Uvicorn ============
# Remove --reload for production (leave empty)
UVICORN_RELOAD=

# ============ Development Only ============
# For development, you can use:
# DEBUG=true
# ENVIRONMENT=development
# JWT_SECRET_KEY=dev-secret-key-change-in-production
# POSTGRES_PASSWORD=postgres
# UVICORN_RELOAD=--reload
