# DocAssist Practice Manager - Environment Configuration
# Copy this file to .env and update values as needed

# ============ Application ============
APP_NAME=DocAssist Practice Manager
APP_VERSION=0.1.0
DEBUG=false

# ============ Paths ============
DATA_DIR=data
LOG_DIR=logs

# ============ Database ============
DATABASE_NAME=practice.db

# ============ EMR Integration ============
# Path to DocAssist EMR database for sync
# EMR_DATABASE_PATH=/path/to/emr/clinic.db
EMR_SYNC_ENABLED=true

# ============ Ollama LLM ============
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120

# ============ Voice Agent ============
VOICE_ENABLED=true
WHISPER_MODEL=base.en
WAKE_WORD=hey docassist
VOICE_LANGUAGE=en

# ============ ChromaDB ============
CHROMA_DIR=chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ============ SMS Gateway ============
SMS_GATEWAY_ENABLED=false
# SMS_GATEWAY_URL=https://your-sms-gateway.com/api
# SMS_GATEWAY_API_KEY=your-api-key

# ============ WhatsApp ============
WHATSAPP_ENABLED=false
# WHATSAPP_API_URL=https://graph.facebook.com/v17.0
# WHATSAPP_API_TOKEN=your-token

# ============ Security ============
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5

# ============ UI ============
THEME_MODE=system
WINDOW_WIDTH=1280
WINDOW_HEIGHT=800
