# DocAssist Practice Manager - Environment Variables

# Application
APP_NAME=DocAssist Practice Manager
VERSION=0.1.0
DEBUG=false
ENVIRONMENT=production  # Options: development, staging, production

# Database (DO NOT use default credentials in production!)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE-THIS-SECURE-PASSWORD
POSTGRES_DB=docassist
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (CRITICAL: Generate secure secret with: openssl rand -hex 32)
JWT_SECRET_KEY=CHANGE-THIS-GENERATE-WITH-OPENSSL-RAND-HEX-32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (Add your production domains)
CORS_ORIGINS=["https://yourdomain.com", "https://app.yourdomain.com"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# SMS/WhatsApp (MSG91)
SMS_API_KEY=
SMS_SENDER_ID=DOCAID

# Voice Agent
WHISPER_MODEL=base.en
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Razorpay (Payment Gateway)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# OTP Settings
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
